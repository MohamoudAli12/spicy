* spicy model library (generic models of common parts).
* spicy copies the .model / .subckt cards a schematic uses into its netlist, so a part's
* value can simply be "1N4148" or "2N3904". These are approximations good for learning and
* first checks: use the manufacturer's model for real design work. Add your own libraries
* with :simulation {:model-libraries ["/path/to/my.lib"]} in settings.edn.

* Kinds and ratings for spicy's model table, in the vendors' "*SRC=part;model;kind;…" form
* (datasheet maximum ratings; the models above are approximations of these parts):
*SRC=1N4148;1N4148;Diodes;Switching;  100V  0.200A  4.00ns   Small-signal switching diode
*SRC=1N914;1N914;Diodes;Switching;  100V  0.200A  4.00ns   Small-signal switching diode
*SRC=1N4007;1N4007;Diodes;Rectifier;  1000V  1.00A   General-purpose rectifier
*SRC=1N5819;1N5819;Diodes;Schottky;  40.0V  1.00A   Schottky barrier rectifier
*SRC=BAT54;BAT54;Diodes;Schottky;  30.0V  0.200A   Small-signal Schottky diode
*SRC=1N4733;1N4733;Diodes;Zener;  5.10V  1.00W   Zener diode
*SRC=1N4742;1N4742;Diodes;Zener;  12.0V  1.00W   Zener diode
*SRC=LED_RED;LED_RED;Diodes;LED;   Red LED
*SRC=LED_GREEN;LED_GREEN;Diodes;LED;   Green LED
*SRC=2N3904;2N3904;BJTs NPN;Si;  40.0V  0.200A  300MHz   Small-signal NPN
*SRC=2N3906;2N3906;BJTs PNP;Si;  40.0V  0.200A  250MHz   Small-signal PNP
*SRC=2N2222;2N2222;BJTs NPN;Si;  30.0V  0.800A  250MHz   General-purpose NPN
*SRC=BC547;BC547;BJTs NPN;Si;  45.0V  0.100A  300MHz   Small-signal NPN
*SRC=BC557;BC557;BJTs PNP;Si;  45.0V  0.100A  150MHz   Small-signal PNP
*SRC=2N7002;2N7002;MOSFETs N;Enh;  60.0V  0.115A  7.50ohms   Small-signal N-MOSFET
*SRC=BS170;BS170;MOSFETs N;Enh;  60.0V  0.500A  5.00ohms   Small-signal N-MOSFET
*SRC=BSS84;BSS84;MOSFETs P;Enh;  50.0V  0.130A  10.0ohms   Small-signal P-MOSFET
*SRC=IRF540;IRF540;MOSFETs N;Enh;  100V  28.0A  0.077ohms   Power N-MOSFET
*SRC=IRF9540;IRF9540;MOSFETs P;Enh;  100V  19.0A  0.200ohms   Power P-MOSFET

* ---- diodes
.model 1N4148 D(IS=2.52n RS=0.568 N=1.752 CJO=4p M=0.4 TT=20n BV=100 IBV=100u)
.model 1N914 D(IS=2.52n RS=0.568 N=1.752 CJO=4p M=0.4 TT=20n BV=100 IBV=100u)
.model 1N4007 D(IS=7.02767n RS=0.0341512 N=1.80803 EG=1.05743 XTI=5 BV=1000 IBV=5e-08 CJO=10p VJ=0.7 M=0.5 FC=0.5 TT=100n)
.model 1N5819 D(IS=31.7u RS=0.051 N=1.373 CJO=110p M=0.35 VJ=0.3 BV=40 IBV=1m EG=0.69 XTI=2)
.model BAT54 D(IS=0.1u RS=1.5 N=1.0 CJO=10p M=0.33 VJ=0.3 BV=30 IBV=10u EG=0.69 XTI=2)
.model 1N4733 D(IS=1n RS=1 N=1 BV=5.1 IBV=49m CJO=100p)
.model 1N4742 D(IS=1n RS=3 N=1 BV=12 IBV=21m CJO=60p)
.model LED_RED D(IS=1e-22 N=1.5 RS=2 BV=5 IBV=10u CJO=30p)
.model LED_GREEN D(IS=1e-28 N=1.6 RS=3 BV=5 IBV=10u CJO=30p)

* ---- bipolar transistors
.model 2N3904 NPN(IS=1e-14 VAF=100 BF=300 IKF=0.4 XTB=1.5 BR=4 CJC=4p CJE=8p RB=20 RC=0.1 RE=0.1 TR=250n TF=350p ITF=1 VTF=2 XTF=3)
.model 2N3906 PNP(IS=1e-14 VAF=100 BF=200 IKF=0.4 XTB=1.5 BR=4 CJC=4.5p CJE=10p RB=20 RC=0.1 RE=0.1 TR=250n TF=350p ITF=1 VTF=2 XTF=3)
.model 2N2222 NPN(IS=14.34f XTI=3 EG=1.11 VAF=74.03 BF=255.9 NE=1.307 ISE=14.34f IKF=0.2847 XTB=1.5 BR=6.092 NC=2 ISC=0 IKR=0 RC=1 CJC=7.306p MJC=0.3416 VJC=0.75 FC=0.5 CJE=22.01p MJE=0.377 VJE=0.75 TR=46.91n TF=411.1p ITF=0.6 VTF=1.7 XTF=3 RB=10)
.model BC547 NPN(IS=7.05f BF=378 VAF=70 IKF=0.08 ISE=68f NE=1.58 BR=3.3 RB=10 RE=0.6 RC=0.25 CJE=13p CJC=4p TF=0.6n TR=10n)
.model BC557 PNP(IS=10f BF=250 VAF=45 IKF=0.08 ISE=10f NE=1.5 BR=3 RB=10 RE=0.6 RC=0.3 CJE=15p CJC=8p TF=0.6n TR=10n)

* ---- MOSFETs (level 1 approximations; W = L = default)
.model 2N7002 NMOS(LEVEL=1 VTO=2.1 KP=0.3 LAMBDA=0.01 RD=1 RS=0.5)
.model BS170 NMOS(LEVEL=1 VTO=2.0 KP=0.5 LAMBDA=0.01 RD=0.8 RS=0.4)
.model BSS84 PMOS(LEVEL=1 VTO=-1.7 KP=0.1 LAMBDA=0.01 RD=3 RS=2)

* ---- power MOSFETs (VDMOS, understood by ngspice and VACASK)
.model IRF540 VDMOS(Rg=3 Vto=4 Rd=20m Rs=10m Rb=17m Kp=20 Cgdmax=2n Cgdmin=150p Cgs=1.4n Cjo=1.5n Is=1.5p mtriode=0.5)
.model IRF9540 VDMOS(pchan Rg=3 Vto=-3.8 Rd=40m Rs=20m Rb=30m Kp=9 Cgdmax=1.6n Cgdmin=120p Cgs=1.3n Cjo=1.2n Is=2p mtriode=0.5)

* ---- voltage-controlled switches (S parts): on when V(CP,CN) > VT+VH, off below VT-VH
.model SW SW(RON=1 ROFF=1Meg VT=0.5 VH=0)
.model SW_HYST SW(RON=1 ROFF=1Meg VT=0.5 VH=0.1)
.model SW_5V SW(RON=0.1 ROFF=100Meg VT=2.5 VH=0.5)
