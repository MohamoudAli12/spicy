;; spicy themes (EDN). spicy reloads this file as soon as you save it.
;; Delete the file to get the default themes back. Pick a theme in View > Theme, or set
;; :ui {:theme "Name"} in settings.edn.
;;
;; Each theme is a map with a :name and three base colours:
;;   :bg      panel background     :fg  text     :accent  highlights, focus, selection
;; Every other colour is worked out from these three, and any of them can be set with
;; the optional maps below. Colours are "#RRGGBB" or "#RRGGBBAA" (with alpha).
;;
;;   :ui         {:bg :panel :bar :fg :muted :accent :accent-fg :input :border :hover
;;                :pressed :sel :warn :ok :err :popup :shadow}
;;   :schematic  {:bg :grid :grid-major :wire :symbol :symbol-fill :pin :junction :ref :value
;;                :text :directive :label :ground :select :hover :net-highlight :op-value
;;                :select-box :placing}
;;   :waveform   {:bg :plot :grid :axis :text :cursor1 :cursor2 :marker :hover :zoom-box
;;                :readout :readout-border}
;;   :traces     ["#RRGGBB" …]   colours given to new traces, in order
;;
;; The first theme is used when the chosen one is not found.

[{:name "Dark" :bg "#282828" :fg "#DDDDDD" :accent "#2F86FF"
  :schematic {:bg "#1E1F22" :grid "#3A3C40" :wire "#4FA8FF" :symbol "#E8E8E8" :symbol-fill "#2A2C31"
              :ref "#9DA3AE" :value "#F2C46D" :directive "#7FD48B" :label "#FF9F5A" :ground "#E6E6E6"}
  :waveform  {:bg "#1E1F22" :plot "#1A1B1E" :grid "#33353A" :axis "#5A5E66"}
  :traces    ["#4FC3F7" "#FF7043" "#9CCC65" "#FFD54F" "#BA68C8" "#4DB6AC" "#F06292" "#A1887F"
              "#90A4AE" "#AED581" "#7986CB" "#FFB74D"]}

