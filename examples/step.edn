;; spicy schematic (EDN)
{:spicy-schematic 1
 :components [{:symbol "voltage" :ref "V1" :value "PULSE(0 1 0 1n 1n 5u 10u)" :at [0 0]}
              {:symbol "res" :ref "R1" :value "{R}" :at [320 -48] :rot 90}
              {:symbol "cap" :ref "C1" :value "1n" :at [416 16]}]
 :wires [[0 -32 224 -32] [0 96 0 128] [0 128 432 128] [0 16 0 -32]
         [432 128 432 80] [432 16 432 -32] [144 -80 144 -32] [304 -32 432 -32]
         [336 -80 336 -32]]
 :flags [{:name "0" :at [0 128]}
         {:name "in" :at [144 -64] :rot 14}
         {:name "out" :at [336 -64] :rot 14}]
 :texts [{:at [0 176] :text "One run per value of R: the traces are labelled by value. A schematic has one .step line."}
         {:at [0 208] :text ".param R=1k" :directive true}
         {:at [0 240] :text ".step param R list 1k 2.2k 4.7k" :directive true}
         {:at [0 272] :text "The other form gives start, stop and increment (stop included): .step param R 1k 5k 2k"}
         {:at [0 304] :text ".tran 20n 10u" :directive true}
         {:at [0 336] :text ".plot V(out)" :directive true}]
 :waves {:plot "" :panes []}}
