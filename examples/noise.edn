{:spicy-schematic 1
 :components [{:symbol "voltage" :ref "V1" :value "PULSE(0 1 0 1n 1n 5u 10u) AC 1" :at [0 0]}
              {:symbol "res" :ref "R1" :value "1k" :at [288 -48] :rot 90}
              {:symbol "cap" :ref "C1" :value "1n" :at [384 16]}]
 :wires [[0 -32 192 -32] [0 96 0 128] [16 128 400 128] [0 16 0 -32]
         [64 -48 64 -32] [400 -48 400 16] [400 80 400 128] [272 -32 400 -32]
