;; spicy symbol library (EDN).
;;
;; spicy always has these symbols built in. Any .edn file in the symbols/ folder of the data
;; folder (~/.local/share/spicy/symbols on Linux) or in a folder listed under
;; :symbols {:folders […]} in settings.edn is read after them: a symbol with the same :name
;; replaces the built-in one, a new name adds a part. Files are reloaded when they change.
;;
;; Coordinates are schematic units with y pointing down; one grid step is 16 units (as in
;; LTspice), and pins must sit on the grid. The symbol's origin is where it is placed.
;;
;;   :name      unique id, used in schematic files            :desc  shown in the part picker
;;   :category  group in the part picker                      :prefix  R → R1, R2 …
;;   :key       keyboard key that starts placing it ("R", "Shift+Q"; nil = none).
;;              shortcuts.edn can override it with :place/<name>.
;;   :value     default value                                 :editor :source | :model | :text
;;   :models    for :editor :model, the model types offered ["NPN"]
;;   :pins      [{:name "A" :at [x y] :cur "c"} …]   :cur names the pin current for probing;
;;              :element "L{ref}_P" makes the pin's current that SPICE element's (a winding)
;;   :cur       current tag of a two-pin part (diode: "d" → ngspice i(@d1[id]))
;;   :probe     :device (default), :source (current of a V source), :none
;;   :spice     netlist line(s); {ref} {value} {<pin name>} {<attribute>} are filled in, and
;;              {<field>} from a "field=…" word of the value ("Lp=1m Ls=1m k=0.99" → {Lp}).
;;              {a|b}: field a if the value has it, else b
;;   :defs      SPICE text added once to every netlist that uses the symbol (.subckt …)
;;   :vacask    the same for VACASK netlists: {:line "…" :load ["spice/x.osdi"] :models ["model …"]
;;              :defs "subckt … ends"}. {source} is the value turned into vsource/isource
;;              parameters, {expr} a behavioural expression; numbers in {value} are written
;;              in plain exponent form (VACASK reads "M" as mega, SPICE as milli).
;;   :ref-at / :value-at   where the name and value are written (unrotated symbol)
;;   :graphics  [:line x y x y …]   polyline           [:rect x0 y0 x1 y1]
;;              [:circle cx cy r]     [:arc cx cy r from-deg to-deg]   (0° = right, 90° = down)
;;              [:poly x y x y … :fill]   closed polygon (:fill fills it with the line colour,
;;              :body with the symbol-fill colour)   [:text x y "+" :size 12]
;;   :kind      :part (default), :ground, :label
;;   :like      "nmos": start from that symbol (pins, graphics, netlist lines, models); the
;;              keys given replace its values. Imported models use it (symbols/imported.edn).

[
 ;; ------------------------------------------------------------------ passives
 {:name "res" :desc "Resistor" :category "Passive" :prefix "R" :key "R" :value "1k" :editor :text
  :vacask {:line "{ref} ({A} {B}) spicy_r r={value}" :load ["spice/resistor.osdi"] :models ["model spicy_r sp_resistor"]}
  :pins [{:name "A" :at [16 16]} {:name "B" :at [16 96]}]
  :spice "{ref} {A} {B} {value}"
  :ref-at [36 44] :value-at [36 70]
  :graphics [[:line 16 16 16 28 4 32 28 40 4 48 28 56 4 64 28 72 4 80 16 84 16 96]]}

