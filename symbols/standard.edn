 ;; Transformers: one inductor per winding (Lp, Ls, Lt: the winding's own inductance, so the
 ;; turns ratio is √(Ls/Lp)), coupled with k (1 = ideal; 0.99… leaves leakage inductance).
 ;; The dots mark the winding ends of the same polarity. Winding resistance: a resistor in series.
 {:name "xfmr" :desc "Transformer (2 windings)" :category "Passive" :prefix "T" :key "X"
  :value "Lp=1m Ls=1m k=0.999" :editor :text
  :vacask {:line "l{ref}_p ({P1} {P2}) spicy_l l={Lp}\nl{ref}_s ({S1} {S2}) spicy_l l={Ls}\nk{ref} () mutual k={k} ind1=\"l{ref}_p\" ind2=\"l{ref}_s\""
           :load ["spice/inductor.osdi"] :models ["model spicy_l sp_inductor" "model mutual mutual"]}
  :pins [{:name "P1" :at [0 0] :element "L{ref}_P"} {:name "P2" :at [0 96] :element "L{ref}_P"}
         {:name "S1" :at [96 0] :element "L{ref}_S"} {:name "S2" :at [96 96] :element "L{ref}_S"}]
  :spice "L{ref}_P {P1} {P2} {Lp}\nL{ref}_S {S1} {S2} {Ls}\nK{ref} L{ref}_P L{ref}_S {k}"
  :ref-at [108 34] :value-at [108 58]
  :graphics [[:line 0 0 32 0 32 16] [:arc 32 24 8 -90 90] [:arc 32 40 8 -90 90] [:arc 32 56 8 -90 90]
             [:arc 32 72 8 -90 90] [:line 32 80 32 96 0 96]
             [:line 45 10 45 86] [:line 51 10 51 86]
             [:line 96 0 64 0 64 16] [:arc 64 24 8 90 270] [:arc 64 40 8 90 270] [:arc 64 56 8 90 270]
             [:arc 64 72 8 90 270] [:line 64 80 64 96 96 96]
             [:circle 21 16 3 :fill] [:circle 75 16 3 :fill]]}

 {:name "xfmr3" :desc "Transformer (3 windings: reset, centre tap, auxiliary …)" :category "Passive" :prefix "T"
  :key "Shift+X" :value "Lp=1m Ls=1m Lt=1m k=0.999" :editor :text
  :vacask {:line "l{ref}_p ({P1} {P2}) spicy_l l={Lp}\nl{ref}_s ({S1} {S2}) spicy_l l={Ls}\nl{ref}_t ({T1} {T2}) spicy_l l={Lt}\nk{ref}_ps () mutual k={kps|k} ind1=\"l{ref}_p\" ind2=\"l{ref}_s\"\nk{ref}_pt () mutual k={kpt|k} ind1=\"l{ref}_p\" ind2=\"l{ref}_t\"\nk{ref}_st () mutual k={kst|k} ind1=\"l{ref}_s\" ind2=\"l{ref}_t\""
           :load ["spice/inductor.osdi"] :models ["model spicy_l sp_inductor" "model mutual mutual"]}
  :pins [{:name "P1" :at [0 64] :element "L{ref}_P"} {:name "P2" :at [0 160] :element "L{ref}_P"}
         {:name "S1" :at [96 0] :element "L{ref}_S"} {:name "S2" :at [96 96] :element "L{ref}_S"}
         {:name "T1" :at [96 128] :element "L{ref}_T"} {:name "T2" :at [96 224] :element "L{ref}_T"}]
  ;; kps, kpt, kst (optional) set the coupling of one pair of windings; k is the rest
  :spice "L{ref}_P {P1} {P2} {Lp}\nL{ref}_S {S1} {S2} {Ls}\nL{ref}_T {T1} {T2} {Lt}\nK{ref}_PS L{ref}_P L{ref}_S {kps|k}\nK{ref}_PT L{ref}_P L{ref}_T {kpt|k}\nK{ref}_ST L{ref}_S L{ref}_T {kst|k}"
  :ref-at [108 34] :value-at [108 58]
  :graphics [[:line 0 64 32 64 32 80] [:arc 32 88 8 -90 90] [:arc 32 104 8 -90 90] [:arc 32 120 8 -90 90]
             [:arc 32 136 8 -90 90] [:line 32 144 32 160 0 160]
             [:line 45 10 45 214] [:line 51 10 51 214]
             [:line 96 0 64 0 64 16] [:arc 64 24 8 90 270] [:arc 64 40 8 90 270] [:arc 64 56 8 90 270]
             [:arc 64 72 8 90 270] [:line 64 80 64 96 96 96]
             [:line 96 128 64 128 64 144] [:arc 64 152 8 90 270] [:arc 64 168 8 90 270] [:arc 64 184 8 90 270]
             [:arc 64 200 8 90 270] [:line 64 208 64 224 96 224]
             [:circle 21 80 3 :fill] [:circle 75 16 3 :fill] [:circle 75 144 3 :fill]]}

