 {:name "opamp" :desc "Op-amp (single pole, 100 dB, 10 MHz GBW)" :category "Amplifiers" :prefix "U" :key "U"
  :value "spicy_opamp" :editor :text :probe :none
  :vacask {:line "{ref} ({In+} {In-} {Out}) {value}" :load ["spice/resistor.osdi" "spice/capacitor.osdi"]
           :models ["model spicy_r sp_resistor" "model spicy_c sp_capacitor" "model vccs vccs" "model vcvs vcvs"]
           :defs "subckt spicy_opamp (inp inn out)\n  rin (inp inn) spicy_r r=10e6\n  g1 (0 int inp inn) vccs gain=1e-3\n  r1 (int 0) spicy_r r=100e6\n  c1 (int 0) spicy_c c=15.9e-12\n  e1 (out 0 int 0) vcvs gain=1\nends"}
  :pins [{:name "In-" :at [-32 48]} {:name "In+" :at [-32 80]} {:name "Out" :at [32 64]}]
  :spice "X{ref} {In+} {In-} {Out} {value}"
  :ref-at [8 28] :value-at [8 104]
  :defs ".subckt spicy_opamp inp inn out\nRin inp inn 10Meg\nG1 0 int inp inn 1m\nR1 int 0 100Meg\nC1 int 0 15.9p\nE1 out 0 int 0 1\n.ends spicy_opamp"
  :graphics [[:poly -32 32 32 64 -32 96 :body] [:line -26 48 -18 48] [:line -26 80 -18 80] [:line -22 76 -22 84]]}

